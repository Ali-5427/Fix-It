# Fix It Environment Variables
# Server-side Gemini API key for AI-assisted audit analysis, rejection diagnosis & reviewer response drafting
GEMINI_API_KEY=

# Server Port (Defaults to 3000 in AI Studio environment)
PORT=3000
NODE_ENV=development

# Public website configuration. Set all values in the production hosting environment.
VITE_SITE_URL=https://app.example.com
VITE_SUPPORT_EMAIL=support@example.com
VITE_LEGAL_EFFECTIVE_DATE=YYYY-MM-DD

# Optional consent-gated telemetry endpoints. Leave blank until implemented.
VITE_ANALYTICS_ENDPOINT=
VITE_ERROR_REPORTING_ENDPOINT=
